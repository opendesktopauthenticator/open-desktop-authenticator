# Copy to `.env` (which is gitignored) — never commit the real file (§11 S15).
#
# Every value here is optional. The spike works with none of them set; it will
# prompt for a password when it needs one, and you can pass maFile paths directly.

# Folder holding your .maFile files. Lets you say `spike code myaccount`
# instead of passing a full path. The spike only READS from here.
# SPIKE_MAFILE_DIR=C:\path\to\your\maFiles

# Password used when a command needs to log in. If unset you are prompted,
# and the value is never written anywhere. Prompting is the safer default —
# only set this if retyping becomes genuinely annoying during testing.
# SPIKE_STEAM_PASSWORD=

# Per-account override. Account name upper-cased, non-alphanumerics as `_`.
# Takes precedence over SPIKE_STEAM_PASSWORD.
# SPIKE_PASSWORD_MYACCOUNT=

# Print stack traces on failure. Stack traces still go through the redaction
# wrapper, but leave this off unless you are debugging.
# SPIKE_DEBUG=1

# Force a password login even when a usable token is stored. Only needed to
# re-test the credentials + Steam Guard handshake.
# SPIKE_FORCE_PASSWORD=1

# Token write-back is ON by default: after any successful login the refreshed
# tokens are written back into the maFile (atomically, with a .bak), so the
# password is only ever asked for once the refresh token actually expires.
# Set this to turn it off and leave your files untouched.
# SPIKE_NO_WRITEBACK=1

# ── Proxy routing ────────────────────────────────────────────────────────────
# Route an account's Steam traffic through a proxy. Both the login (steam-session)
# and the confirmation traffic (steamcommunity) go through it, or the command
# refuses to run — see docs/PHASE0_FINDINGS.md F-08.
#
# Supported: http, https, socks4, socks5, socks5h.
# Prefer socks5h over socks5: it resolves DNS at the proxy, so your local
# resolver never sees the Steam hostnames.
#
# The proxy operator sees every host you connect to. Contents stay TLS-encrypted
# unless you have installed that proxy's CA certificate — do not do that.
# SPIKE_PROXY=socks5h://user:pass@host:1080

# Per-account proxy. Account name upper-cased, non-alphanumerics as `_`.
# This is what routes each account over a different exit.
# SPIKE_PROXY_MYACCOUNT=socks5h://user:pass@host:1080

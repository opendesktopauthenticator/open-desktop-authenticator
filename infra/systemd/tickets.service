[Unit]
Description=Issue tracker for opendesktopauthenticator.com
After=network.target

[Service]
Type=simple
User=tickets
Group=tickets
WorkingDirectory=/opt/tickets
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=TICKETS_DB=/var/lib/tickets/tickets.db
ExecStart=/usr/bin/node /opt/tickets/server.mjs
Restart=on-failure
RestartSec=5s

# --- what this process is allowed to be ------------------------------------
#
# It is the only executing thing on the domain, so it is fenced in hard. Most of
# this is not because the code is suspected — it is because the cost of being
# wrong should be bounded before anyone needs it to be.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RemoveIPC=yes
UMask=0077

# The database directory is the only writable path in the filesystem.
ReadWritePaths=/var/lib/tickets

# Loopback only. It cannot reach the internet even if something told it to.
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Bounded, so a runaway cannot take the box down with it.
#
# **A cap only bounds the damage if nothing an anonymous caller does scales with
# memory.** For a while something did: the upload endpoint assembled each body in
# memory and then duplicated it with `Buffer.concat`, and nginx permits eight
# concurrent 21m uploads per address on that path. Measured, eight of them took
# this process from 75 MiB to 398 MiB, so systemd killed it — and killing it
# takes report submission, reporter access to existing reports and the admin
# queue with it, for everyone, on eight unauthenticated requests. The cap did its
# job; it was the only thing standing between a stranger and the box, and it was
# being used as a trigger rather than a backstop.
#
# Uploads now stream to a file in /var/lib/tickets/attachments as they arrive and
# hold sixty-four bytes each, so this is a backstop again. Keep it that way:
# anything added here that grows with the size of a request body has to be
# checked against this number times nginx's `limit_conn` before it ships.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target

# opendesktopauthenticator.com
#
# NOTE: this opening paragraph described the pre-TLS state and was left behind.
# HTTPS is live below. Kept for the reasoning, not as a description of today:
# HTTP only at the time, because the domain resolved to Cloudflare and there was no
# certificate yet. The ACME location is live, so certbot will work the moment
# DNS points here and will add the TLS server and redirect itself.

# One canonical hostname. Serving the whole site on www as well as the apex is
# two copies of every page as far as a crawler is concerned; the canonical tag
# asks it to pick one, a 301 tells it.
server {
	listen 80;
	listen [::]:80;
	server_name www.opendesktopauthenticator.com;

	# ACME first: a certificate for www has to be obtainable without following
	# the redirect, or renewal for that name quietly stops working.
	location ^~ /.well-known/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		access_log off;
	}

	location / {
		# Straight to HTTPS on the apex, not to plain HTTP on the apex.
		#
		# Redirecting to `http://` meant two hops for anyone typing the www name,
		# and the first of them landed on cleartext — a redirect that goes via HTTP
		# is a redirect an attacker on the network gets to answer, which is the
		# whole reason HSTS exists on the second hop.
		return 301 https://opendesktopauthenticator.com$request_uri;
	}
}

# Port 80 stays for the ACME challenge and to send everything else to HTTPS.
server {
	listen 80;
	listen [::]:80;
	server_name opendesktopauthenticator.com;

	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		access_log off;
	}

	# Straight to the canonical HTTPS URL in one hop. Without these, /x.html went
	# to https://…/x.html and was redirected again — two hops for every legacy
	# link, each one a little latency and a little link equity.
	location ~ ^(/.+)\.html$ {
		return 301 https://opendesktopauthenticator.com$1;
	}

	location ~ ^(/.+)/$ {
		return 301 https://opendesktopauthenticator.com$1;
	}

	location = /index.html {
		return 301 https://opendesktopauthenticator.com/;
	}

	location / {
		return 301 https://opendesktopauthenticator.com$request_uri;
	}
}

# www over TLS, redirecting to the apex.
#
# **Without this block nginx has no 443 server for www**, so it falls back to
# the first 443 server it has — the apex — and serves every page a second time
# under the wrong hostname. The canonical tag asks a crawler to ignore that; a
# 301 means it never sees it. Verified before this existed: https://www/ was
# returning 200 with the apex page.
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name www.opendesktopauthenticator.com;

	include snippets/tls.conf;

	return 301 https://opendesktopauthenticator.com$request_uri;
}

server {
	# `http2 on;` as its own directive needs nginx 1.25.1; this is 1.24, where it
	# is a listen parameter. The standalone form is not a warning, it is a hard
	# "unknown directive" that stops nginx loading.
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name opendesktopauthenticator.com;

	include snippets/tls.conf;

	root /var/www/oda/public;
	index index.html;
	charset utf-8;

	include snippets/security-headers.conf;

	limit_req  zone=site burst=60 nodelay;
	limit_conn perip 24;

	# ^~ so no regex below can ever shadow it.
	location ^~ /.well-known/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		access_log off;
	}

	# --- one address per page ------------------------------------------------
	#
	# `try_files $uri $uri.html` means /security.html and /security both served
	# the same bytes, and /index.html duplicated the home page. Ten pages, each
	# reachable three ways, is thirty URLs for eleven pages of content. These
	# three rules collapse them.
	#
	# Exact matches outrank regexes in nginx, which is what keeps the internal
	# error_page redirect to /404.html from being turned into a 301 and breaking
	# every 404 on the site.
	location = /index.html { return 301 /; }
	location = /404.html   { internal; }
	location ~ ^(/.+)\.html$ { return 301 $1; }
	location ~ ^(/.+)/$      { return 301 $1; }

	location / {
		# **HTML must revalidate; assets must not.**
		#
		# With no Cache-Control at all a browser is free to guess a freshness
		# lifetime from Last-Modified, so a corrected security page can sit stale
		# in someone's browser for days with nothing to force a refresh.
		# `no-cache` does not mean "do not store" — it means "store it, but ask
		# before reusing it". The ETag then makes that question cost a 304, so
		# revalidation is nearly free and updates are immediate.
		#
		# The assets can be cached hard precisely because their filenames carry a
		# content hash: new bytes are always a new URL.
		#
		# **The browser and the edge are told different things, deliberately, and
		# in different headers.**
		#
		# `Cache-Control: no-cache` is unchanged and keeps the guarantee above: a
		# browser revalidates every time, so a corrected page is never served
		# stale from somebody's disk.
		#
		# `CDN-Cache-Control` speaks only to shared caches and is invisible to
		# browsers. It exists because the obvious approach does not work: a single
		# `Cache-Control: public, max-age=0, s-maxage=300` looks right and
		# Cloudflare refuses to cache it, because its documented rule is that
		# `max-age=0` makes a response uncacheable *regardless of s-maxage*. That
		# was tried here first and the edge kept answering DYNAMIC.
		#
		# Five minutes is chosen against the deploy, not the content: every HTML
		# response was being fetched from Germany, measured at 0.47s to 0.93s
		# before the first byte for every reader, and a page is never wrong for
		# longer than one cache period after a correction ships.
		#
		# `stale-while-revalidate` means the one unlucky request after expiry is
		# served from the edge while the refresh happens behind it, rather than
		# being the request that pays for everyone else's freshness.
		#
		# **This alone is not enough.** Cloudflare caches by file extension and
		# does not consider HTML eligible at all, whatever the headers say, until
		# a Cache Rule says so. The rule is a dashboard setting, so it is recorded
		# in docs/CACHING.md rather than here where it cannot be applied.
		#
		# Private routes are not covered by this block — the ticket service and
		# /admin proxy through their own location and send `no-store`, which is
		# what keeps a support thread out of a shared cache. Asserted in
		# `tests/infra-caching.test.ts`, because "a different location block" is
		# not a guarantee anybody can see from here.
		add_header Cache-Control "no-cache" always;
		add_header CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400" always;
		include snippets/security-headers.conf;
		try_files $uri $uri.html $uri/index.html =404;
	}

	# --- assets --------------------------------------------------------------
	#
	# **The include is load-bearing.** An `add_header` anywhere in a location
	# discards every add_header inherited from the server block — so adding a
	# Cache-Control here silently stripped the CSP and all four other security
	# headers from every stylesheet and image on the site. Re-including them is
	# the only way to get them back.
	location /assets/ {
		include snippets/security-headers.conf;
		expires 1y;
		add_header Cache-Control "public, immutable";
		access_log off;
	}

	# The icons browsers fetch by name, and the manifest.
	#
	# **These are the one part of the icon set that cannot be content-hashed**,
	# because nothing in our HTML names them — the browser just asks for
	# /favicon.ico. So they get `no-cache` rather than the `immutable` used for
	# hashed assets: store it, but ask before reusing it. The ETag makes that
	# question cost a 304 of a couple of hundred bytes, and it is what guarantees
	# a changed mark actually replaces the one already sitting in a tab strip.
	# Getting this wrong is how a stale or generic favicon outlives three
	# redesigns.
	#
	# The same split as the HTML: the browser keeps revalidating, so a changed
	# mark still replaces the one in the tab strip, while the edge is allowed to
	# answer for an hour instead of crossing to Germany for a 15KB icon every
	# visitor asks for by name.
	location ~ ^/(favicon\.ico|apple-touch-icon(-precomposed)?\.png|site\.webmanifest)$ {
		include snippets/security-headers.conf;
		add_header Cache-Control "no-cache" always;
		add_header CDN-Cache-Control "public, max-age=3600, stale-while-revalidate=86400" always;
		# Not in nginx's default mime.types, and the wrong type means the manifest
		# is ignored and Android falls back to a screenshot of the page.
		types { application/manifest+json webmanifest; image/x-icon ico; image/png png; }
		default_type application/octet-stream;
	}

	# --- the ticket service --------------------------------------------------
	#
	# The only proxied path on the domain. Everything else is a file on disk, and
	# keeping it that way is why this block is as narrow as it is: three exact
	# prefixes, not a catch-all.
	#
	# `tickets` is a 6-per-minute zone. Submitting a report is a human action a
	# handful of times a day, so anything faster is a script, and the origin
	# should refuse it before Node ever allocates for it.
	# Uploads, kept apart from every other proxied path.
	#
	# It is the only place on the domain that accepts a body worth more than a
	# form post, so it is the only place `client_max_body_size` is raised — and it
	# is raised here rather than on the parent so that a large body posted at any
	# other path is still refused by nginx before it reaches Node.
	#
	# Regex locations match in order, so this has to precede the general block
	# below or the general one would swallow it.
	# Matches the upload endpoint and the withdrawal of one upload by id.
	#
	# Was `location = /support/attach`, an exact match, so `DELETE
	# /support/attach/<id>` fell past it to the static handler and answered 404 —
	# the service's delete route was correct and unreachable, and every unit test
	# passed because none of them goes through nginx. Only trying it against the
	# live site found this.
	# Quoted, because nginx parses an unquoted `{32}` as a block delimiter and
	# refuses to load with "missing closing parenthesis".
	location ~ "^/support/attach(/[0-9a-f]{32})?$" {
		include snippets/security-headers.conf;
		# Four files per report, and a person files few reports: 30/minute with a
		# burst of 8 is unnoticeable to a human and useless for filling a disk.
		limit_req  zone=uploads burst=8 nodelay;
		limit_conn perip 8;

		proxy_pass http://127.0.0.1:8787;
		proxy_http_version 1.1;
		proxy_set_header Host              $host;
		proxy_set_header X-Real-IP         $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header Connection        "";

		proxy_hide_header Cache-Control;
		proxy_hide_header Referrer-Policy;
		proxy_hide_header X-Content-Type-Options;

		# One byte over the largest thing the service accepts. The service checks
		# again; this is so an oversized body dies at the edge rather than after a
		# proxy hop.
		client_max_body_size 21m;
		client_body_timeout  60s;
		proxy_read_timeout   60s;
		proxy_request_buffering on;

		add_header Cache-Control "no-store" always;
	}

	location ~ ^/(support/submit|support/ticket/|admin) {
		include snippets/security-headers.conf;
		# These URLs can carry a report's access key. Log the path, never the
		# query string or the referer. See log_format sensitive in 00-hardening.
		access_log /var/log/nginx/access.log sensitive;
		limit_req  zone=tickets burst=4 nodelay;
		limit_conn perip 8;

		proxy_pass http://127.0.0.1:8787;
		proxy_http_version 1.1;

		# The service sets these too, so that it is still safe if it is ever reached
		# directly. Behind nginx that means two copies of each on the wire, and two
		# Referrer-Policy values is not merely untidy — the browser takes the last
		# valid one, so which policy actually applies depends on header order rather
		# than on either config saying so. nginx is the single authority here; the
		# upstream's copies are dropped.
		proxy_hide_header Cache-Control;
		proxy_hide_header Referrer-Policy;
		proxy_hide_header X-Content-Type-Options;
		proxy_set_header Host              $host;
		# The real client, which the service uses for its own rate limiting. Only
		# meaningful because the Cloudflare real-IP block established it.
		proxy_set_header X-Real-IP         $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header Connection        "";

		# A form post is small and quick, or it is not a form post.
		client_max_body_size 32k;
		proxy_read_timeout   15s;
		proxy_connect_timeout 5s;

		# Never cached, at any layer: these are per-person pages.
		add_header Cache-Control "no-store" always;
	}

	location = /sitemap.xml {
		include snippets/security-headers.conf;
		add_header Cache-Control "public, max-age=3600";
	}

	# RFC 9116. A security product with no route for reporting a vulnerability
	# is asking to be told about one on a public forum instead.
	location = /.well-known/security.txt {
		include snippets/security-headers.conf;
		default_type "text/plain";
		alias /var/www/oda/public/security.txt;
	}

	location ~ /\. { deny all; }
	location ~ ~$  { deny all; }

	error_page 404 /404.html;
}

# opendesktopauthenticator.com
#
# HTTP only for now: the domain still resolves to Cloudflare, so there is no
# certificate yet. The ACME location is live, so certbot will work the moment
# DNS points here and will add the TLS server and redirect itself.

# One canonical hostname. Serving the whole site on www as well as the apex is
# two copies of every page as far as a crawler is concerned; the canonical tag
# asks it to pick one, a 301 tells it.
server {
	listen 80;
	listen [::]:80;
	server_name www.opendesktopauthenticator.com;

	# ACME first: a certificate for www has to be obtainable without following
	# the redirect, or renewal for that name quietly stops working.
	location ^~ /.well-known/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		access_log off;
	}

	location / {
		return 301 http://opendesktopauthenticator.com$request_uri;
	}
}

# Port 80 stays for the ACME challenge and to send everything else to HTTPS.
server {
	listen 80;
	listen [::]:80;
	server_name opendesktopauthenticator.com;

	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		access_log off;
	}

	# Straight to the canonical HTTPS URL in one hop. Without these, /x.html went
	# to https://…/x.html and was redirected again — two hops for every legacy
	# link, each one a little latency and a little link equity.
	location ~ ^(/.+)\.html$ {
		return 301 https://opendesktopauthenticator.com$1;
	}

	location ~ ^(/.+)/$ {
		return 301 https://opendesktopauthenticator.com$1;
	}

	location = /index.html {
		return 301 https://opendesktopauthenticator.com/;
	}

	location / {
		return 301 https://opendesktopauthenticator.com$request_uri;
	}
}

# www over TLS, redirecting to the apex.
#
# **Without this block nginx has no 443 server for www**, so it falls back to
# the first 443 server it has — the apex — and serves every page a second time
# under the wrong hostname. The canonical tag asks a crawler to ignore that; a
# 301 means it never sees it. Verified before this existed: https://www/ was
# returning 200 with the apex page.
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name www.opendesktopauthenticator.com;

	include snippets/tls.conf;

	return 301 https://opendesktopauthenticator.com$request_uri;
}

server {
	# `http2 on;` as its own directive needs nginx 1.25.1; this is 1.24, where it
	# is a listen parameter. The standalone form is not a warning, it is a hard
	# "unknown directive" that stops nginx loading.
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name opendesktopauthenticator.com;

	include snippets/tls.conf;

	root /var/www/oda/public;
	index index.html;
	charset utf-8;

	include snippets/security-headers.conf;

	limit_req  zone=site burst=60 nodelay;
	limit_conn perip 24;

	# ^~ so no regex below can ever shadow it.
	location ^~ /.well-known/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		access_log off;
	}

	# --- one address per page ------------------------------------------------
	#
	# `try_files $uri $uri.html` means /security.html and /security both served
	# the same bytes, and /index.html duplicated the home page. Ten pages, each
	# reachable three ways, is thirty URLs for eleven pages of content. These
	# three rules collapse them.
	#
	# Exact matches outrank regexes in nginx, which is what keeps the internal
	# error_page redirect to /404.html from being turned into a 301 and breaking
	# every 404 on the site.
	location = /index.html { return 301 /; }
	location = /404.html   { internal; }
	location ~ ^(/.+)\.html$ { return 301 $1; }
	location ~ ^(/.+)/$      { return 301 $1; }

	location / {
		# **HTML must revalidate; assets must not.**
		#
		# With no Cache-Control at all a browser is free to guess a freshness
		# lifetime from Last-Modified, so a corrected security page can sit stale
		# in someone's browser for days with nothing to force a refresh.
		# `no-cache` does not mean "do not store" — it means "store it, but ask
		# before reusing it". The ETag then makes that question cost a 304, so
		# revalidation is nearly free and updates are immediate.
		#
		# The assets can be cached hard precisely because their filenames carry a
		# content hash: new bytes are always a new URL.
		add_header Cache-Control "no-cache" always;
		include snippets/security-headers.conf;
		try_files $uri $uri.html $uri/index.html =404;
	}

	# --- assets --------------------------------------------------------------
	#
	# **The include is load-bearing.** An `add_header` anywhere in a location
	# discards every add_header inherited from the server block — so adding a
	# Cache-Control here silently stripped the CSP and all four other security
	# headers from every stylesheet and image on the site. Re-including them is
	# the only way to get them back.
	location /assets/ {
		include snippets/security-headers.conf;
		expires 1y;
		add_header Cache-Control "public, immutable";
		access_log off;
	}

	# The icons browsers fetch by name, and the manifest.
	#
	# **These are the one part of the icon set that cannot be content-hashed**,
	# because nothing in our HTML names them — the browser just asks for
	# /favicon.ico. So they get `no-cache` rather than the `immutable` used for
	# hashed assets: store it, but ask before reusing it. The ETag makes that
	# question cost a 304 of a couple of hundred bytes, and it is what guarantees
	# a changed mark actually replaces the one already sitting in a tab strip.
	# Getting this wrong is how a stale or generic favicon outlives three
	# redesigns.
	location ~ ^/(favicon\.ico|apple-touch-icon(-precomposed)?\.png|site\.webmanifest)$ {
		include snippets/security-headers.conf;
		add_header Cache-Control "no-cache" always;
		# Not in nginx's default mime.types, and the wrong type means the manifest
		# is ignored and Android falls back to a screenshot of the page.
		types { application/manifest+json webmanifest; image/x-icon ico; image/png png; }
		default_type application/octet-stream;
	}

	# --- the ticket service --------------------------------------------------
	#
	# The only proxied path on the domain. Everything else is a file on disk, and
	# keeping it that way is why this block is as narrow as it is: three exact
	# prefixes, not a catch-all.
	#
	# `tickets` is a 6-per-minute zone. Submitting a report is a human action a
	# handful of times a day, so anything faster is a script, and the origin
	# should refuse it before Node ever allocates for it.
	location ~ ^/(support/submit|support/ticket/|admin) {
		include snippets/security-headers.conf;
		limit_req  zone=tickets burst=4 nodelay;
		limit_conn perip 8;

		proxy_pass http://127.0.0.1:8787;
		proxy_http_version 1.1;
		proxy_set_header Host              $host;
		# The real client, which the service uses for its own rate limiting. Only
		# meaningful because the Cloudflare real-IP block established it.
		proxy_set_header X-Real-IP         $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header Connection        "";

		# A form post is small and quick, or it is not a form post.
		client_max_body_size 32k;
		proxy_read_timeout   15s;
		proxy_connect_timeout 5s;

		# Never cached, at any layer: these are per-person pages.
		add_header Cache-Control "no-store" always;
	}

	location = /sitemap.xml {
		include snippets/security-headers.conf;
		add_header Cache-Control "public, max-age=3600";
	}

	# RFC 9116. A security product with no route for reporting a vulnerability
	# is asking to be told about one on a public forum instead.
	location = /.well-known/security.txt {
		include snippets/security-headers.conf;
		default_type "text/plain";
		alias /var/www/oda/public/security.txt;
	}

	location ~ /\. { deny all; }
	location ~ ~$  { deny all; }

	error_page 404 /404.html;
}
